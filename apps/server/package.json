{
  "name": "@lukaisailovic/health-mcp",
  "version": "0.1.0",
  "description": "Self-hosted MCP server for personal nutrition, biomarkers, and wearables data",
  "type": "module",
  "bin": {
    "health-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "public", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/biomarkers/seed-biomarkers.json dist/biomarkers/seed-biomarkers.json",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "inspect": "npx -y @modelcontextprotocol/inspector node --import tsx src/index.ts --stdio",
    "prepublishOnly": "pnpm --filter @health-mcp/shared build && pnpm --filter @health-mcp/dashboard build && pnpm build"
  },
  "dependencies": {
    "@health-mcp/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.5.0",
    "croner": "^9.0.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "undici": "^7.1.0",
    "vitest": "^2.1.6"
  }
}
